---
import { Image } from "astro:assets";

import Divider from "../assets/images/leaf-divider.png";
import ContactAlpaca from "../assets/images/contact-alpaca.png";
---

<section class="contact" id="contact">
    <div class="contact__inner">
        <div class="contact__information">
            <div class="contact__header">
                <h2>Contact</h2>

                <img
                    src={Divider.src}
                    alt=""
                    class="contact__divider"
                />
            </div>

            <div class="contact__details">
                <p class="contact__intro">
                    Whether you need shearing for a small flock of sheep, alpacas, or
                    general animal husbandry assistance, get in touch with Andrew to discuss your needs.
                </p>

                <ul class="contact__list">
                    <li class="contact__item">
                        <span class="contact__icon" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M7.2 3.5L9.5 7.8L7.8 9.6C8.7 11.5 10.2 13.1 12.1 14L13.9 12.3L18.2 14.6V18.1C18.2 18.8 17.6 19.4 16.9 19.4C10 19 4.5 13.5 4.1 6.6C4.1 5.9 4.7 5.3 5.4 5.3L7.2 3.5Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>

                        <a class="phone-link" href="tel:+61447129207">
                            0447 129 207
                        </a>
                    </li>

                    <li class="contact__item">
                        <span class="contact__icon" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M4 6.5H20V17.5H4V6.5Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round"
                                />

                                <path
                                    d="M4.5 7L12 12.5L19.5 7"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </span>

                        <a href="mailto:info@thecountryshearer.com.au">
                            info@thecountryshearer.com.au
                        </a>
                    </li>

                    <li class="contact__item contact__item--location">
                        <span class="contact__icon" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M12 21C12 21 18 15.5 18 9.5C18 6.2 15.3 3.5 12 3.5C8.7 3.5 6 6.2 6 9.5C6 15.5 12 21 12 21Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round"
                                />

                                <circle
                                    cx="12"
                                    cy="9.5"
                                    r="2"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                />
                            </svg>
                        </span>

                        <span>
                            Greater Sydney and surrounds, and available for travel.
                        </span>
                    </li>
                </ul>
            </div>
        </div>

        <form
            class="contact__form"
            method="POST"
            action="/api/contact"
            autocomplete="off"
        >
            <div class="contact__field">
                <label for="contact-name">Name</label>

                <input
                    type="text"
                    id="contact-name"
                    name="name"
                    autocomplete="off"
                    required
                />
            </div>

            <div class="contact__field">
                <label for="contact-email">Email</label>

                <input
                    type="email"
                    id="contact-email"
                    name="email"
                    autocomplete="off"
                    required
                />
            </div>

            <div class="contact__field">
                <label for="contact-phone">Phone</label>

                <input
                    type="tel"
                    id="contact-phone"
                    name="phone"
                    autocomplete="off"
                />
            </div>

            <div class="contact__field">
                <label for="contact-message">Message</label>

                <textarea
                    id="contact-message"
                    name="message"
                    rows="6"
                    autocomplete="off"
                    required
                ></textarea>
            </div>

            <div
                class="contact__honeypot"
                aria-hidden="true"
            >
                <label for="contact-website">
                    Website
                </label>

                <input
                    type="text"
                    id="contact-website"
                    name="website"
                    tabindex="-1"
                    autocomplete="off"
                />
            </div>

            <button
                type="submit"
                class="contact__submit"
            >
                Send Enquiry
            </button>
        </form>

        <div class="contact__image" aria-hidden="true">
            <Image
                src={ContactAlpaca}
                alt=""
                widths={[450, 650, 850]}
                sizes="(min-width: 1100px) 30vw, (min-width: 700px) 38vw, 100vw"
                loading="lazy"
            />
        </div>
    </div>
</section>
